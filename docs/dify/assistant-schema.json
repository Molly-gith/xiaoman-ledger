{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "intent": { "type": "string", "enum": ["transactions", "question", "clarification"] },
    "transactions": {
      "type": "array", "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "type": { "type": "string", "enum": ["income", "expense"] },
          "amount": { "type": "number", "exclusiveMinimum": 0, "maximum": 999999999999.99 },
          "category": { "type": "string", "enum": ["餐饮", "购物", "交通", "居住", "健康", "医疗", "学习", "娱乐", "收入", "其他"] },
          "occurred_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "note": { "type": "string", "maxLength": 100 },
          "nature_suggestion": { "type": ["string", "null"], "enum": ["消费", "浪费", "投资", null] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "ambiguous": { "type": "boolean" }
        },
        "required": ["type", "amount", "category", "occurred_at", "note", "nature_suggestion", "confidence", "ambiguous"]
      }
    },
    "answer": { "type": "string", "maxLength": 1200 },
    "next_actions": { "type": "array", "maxItems": 3, "items": { "type": "string", "maxLength": 300 } },
    "referenced_facts": { "type": "array", "items": { "type": "string" } },
    "clarification": { "type": "string", "maxLength": 300 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "required": ["intent", "transactions", "answer", "next_actions", "referenced_facts", "clarification", "confidence"]
}
