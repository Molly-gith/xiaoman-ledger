{
  "action": "rules.insert",
  "value": {
    "name": "Xiaoman private question limit",
    "description": "Limit authorized Ask Xiaoman model calls through the Firewall SDK.",
    "active": true,
    "conditionGroup": [
      { "conditions": [ { "type": "rate_limit_api_id", "op": "eq", "value": "xiaoman-question" } ] }
    ],
    "action": {
      "mitigate": {
        "action": "rate_limit",
        "rateLimit": { "algo": "fixed_window", "window": 60, "limit": 6, "keys": ["ip"], "action": "rate_limit" }
      }
    }
  }
}
